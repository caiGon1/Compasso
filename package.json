{
  "name": "compasso",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/local.mjs",
    "build": "vite build",
    "start": "node server/local.mjs",
    "test": "vitest run",
    "build:vercel": "npm run build",
    "db:migrate": "node --env-file=.env.local scripts/migrate-postgres.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "node --env-file=.env.test.local scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^29.1.1",
    "vite": "^6.1.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": "24.x"
  }
}
